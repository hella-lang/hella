// std::io — terminal IO for Hella (real stdlib: pure Hella + extern FFI).
// Import via: import std::io
// or selective: import std::io::{print, println}
//
// User-facing IO is defined here; the compiler only supplies `extern "c"`
// lowering and internal libc helpers for assert and interpolation.
// Every user-facing IO name below is an ordinary Hella function defined here.
// If you call `print` without `import std::io`, sema must report an
// undefined name — that is the intended boundary, not a bug.
//
// Hella `string` is a null-terminated `ptr (i8*)`; `char` is `i32`.
// `write` targets fd 2 (stderr) directly so no FILE* global is needed.
// See stdlib/README.md for the current compiler's extern ABI limitations.
// Input buffers come zeroed from calloc; readLine grows and copies them.

extern "c" from "libc" do
    i32 puts(string s)
    i32 printf(string fmt, ...)
    int write(int fd, string buf, int count)
    string calloc(int n, int size)
    int getchar()
    void free(string buf)
end

/// Prints `s` to stdout with no trailing newline.
void print(string s) do
    printf("%s", s)
end

/// Prints `s` to stdout with a trailing newline (via libc `puts`).
void println(string s) do
    puts(s)
end

/// Prints `s` to stderr (fd 2) with no trailing newline.
void eprint(string s) do
    write(2, s, s.len())
end

/// Prints `s` to stderr (fd 2) with a trailing newline.
void eprintln(string s) do
    eprint(s)
    eprint("\n")
end

/// Reads one line without LF. Returns true for a newline-terminated line,
/// including an empty line, and for a nonempty final line ending at EOF.
/// Returns false at EOF/read failure before any bytes or when the line
/// contains NUL; the latter is consumed through its line ending. Both cases
/// reset line to "". CR bytes are preserved. EOF and read errors cannot
/// currently be distinguished. The caller owns a returned heap buffer.
bool tryReadLine(ref string line) do
    int capacity = 256
    int size = 0
    string buf = calloc(1, capacity)
    assert buf is not null
    bool sawInput = false
    line = ""
    while true do
        int byte = getchar()
        if byte < 0 do
            break
        end
        sawInput = true
        if byte is 10 do
            break
        end
        if byte is 0 do
            while true do
                byte = getchar()
                if byte < 0 or byte is 10 do
                    break
                end
            end
            free(buf)
            return false
        end else do
            if size is capacity - 1 do
                assert capacity <= 4611686018427387903
                capacity = capacity * 2
                string grown = calloc(1, capacity)
                assert grown is not null
                int i = 0
                while i < size do
                    grown[i] = buf[i]
                    i = i + 1
                end
                free(buf)
                buf = grown
            end
            buf[size] = byte
            size = size + 1
        end
    end
    if not sawInput do
        free(buf)
        return false
    end
    line = buf
    return true
end

/// Reads a line without LF. At EOF/read failure before any bytes, or for a line containing
/// NUL, returns "". Use tryReadLine when those cases must be distinguished.
string readLine() do
    string line = ""
    tryReadLine(ref line)
    return line
end
