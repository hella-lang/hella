// std::env — environment utilities for Hella (real stdlib: pure Hella + extern FFI).
// Import via: import std::env

import std::str

extern "c" from "libc" do
    string getenv(string name)
    void exit(int code)
    string calloc(int n, int size)
    void free(string buf)
end

@cfg(unix)
extern "c" from "libc" do
    int setenv(string name, string value, int overwrite)
    int unsetenv(string name)
    string getcwd(string buf, int size)
end

@cfg(windows)
extern "c" from "libc" do
    int _putenv_s(string name, string value)
    string _getcwd(string buf, int size)
end

@cfg(unix)
int envSet(string name, string value) do
    return setenv(name, value, 1)
end

@cfg(windows)
int envSet(string name, string value) do
    return _putenv_s(name, value)
end

@cfg(unix)
int envUnset(string name) do
    return unsetenv(name)
end

@cfg(windows)
int envUnset(string name) do
    return _putenv_s(name, "")
end

@cfg(unix)
string envGetCwd(string buf, int size) do
    return getcwd(buf, size)
end

@cfg(windows)
string envGetCwd(string buf, int size) do
    return _getcwd(buf, size)
end

// Compiler-provided: argv[0] captured at startup (the program name as the
// parent exec'd it — a path or bare name, never `""` in a real run).
// Declared extern so sema stays untouched; codegen intercepts the call and
// loads the `__hella_argv0` global instead, so despite the `from "libc"`
// header no libc symbol is required or referenced.
extern "c" from "libc" do
    string __hella_progname()
end

/// Stores the environment value in `value`; returns false and resets `value`
/// when the variable is unset. On success, `value` borrows libc-owned storage
/// and may be invalidated by later environment changes.
bool tryGetEnv(string name, ref string value) do
    value = ""
    string found = getenv(name)
    if found is null do
        return false
    end
    value = found
    return true
end

/// Returns the value of env var `name`, or `""` when unset. A set value is
/// borrowed from libc and may be invalidated by later environment changes.
string getEnv(string name) do
    string value = ""
    if not tryGetEnv(name, ref value) do
        return ""
    end
    return value
end

/// Returns true when env var `name` is set (even to an empty value).
bool hasEnv(string name) do
    string v = getenv(name)
    return v is not null
end

/// Sets env var `name` to `value` (overwrites).
void setEnv(string name, string value) do
    envSet(name, value)
end

/// Sets env var `name` to `value` (overwrites); returns false on failure.
bool trySetEnv(string name, string value) do
    return envSet(name, value) is 0
end

/// Removes env var `name` when present.
void unsetEnv(string name) do
    envUnset(name)
end

/// Removes env var `name`; returns false when the operation fails.
bool tryUnsetEnv(string name) do
    return envUnset(name) is 0
end

/// Stores the current working directory in `path`; returns false and resets
/// `path` on failure. Successful output is caller-owned heap storage.
bool tryCwd(ref string path) do
    path = ""
    int size = 1024
    string buf = calloc(1, size)
    if buf is null do
        return false
    end
    string result = envGetCwd(buf, size)
    if result is null do
        free(buf)
        return false
    end
    path = result
    return true
end

/// Returns the current working directory, or `""` on failure.
string cwd() do
    string path = ""
    if not tryCwd(ref path) do
        return ""
    end
    return path
end

/// Terminates the process immediately with `code` (via libc `exit`).
/// Deferred cleanup does not run; reserve for fatal paths.
void exitProcess(int code) do
    exit(code)
end

/// Returns the program name (`argv[0]`) as the parent exec'd it,
/// or `""` when unavailable.
string progName() do
    string p = __hella_progname()
    if p is null do
        return ""
    end
    return p
end

/// Returns the current user's home directory (`HOME`, else `USERPROFILE`
/// for Windows), or `""` when neither is set or both are empty.
/// Pure lookup — no `~` expansion is performed anywhere.
string homeDir() do
    string home = getEnv("HOME")
    if not isEmpty(home) do
        return home
    end
    return getEnv("USERPROFILE")
end

/// Returns a scratch directory (`TMPDIR`, else `TEMP`, else `TMP`),
/// or `""` when none is set. Empty values are skipped like missing ones.
/// No trailing slash is guaranteed; join with `std::path::joinPath`.
/// There is intentionally no `/tmp` fallback — it does not exist on
/// Windows, so callers handle `""` (e.g. fall back to `cwd()`).
string tempDir() do
    string dir = getEnv("TMPDIR")
    if not isEmpty(dir) do
        return dir
    end
    dir = getEnv("TEMP")
    if not isEmpty(dir) do
        return dir
    end
    return getEnv("TMP")
end
