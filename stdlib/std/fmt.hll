// std::fmt — text composition, not C format strings.
// Use Hella interpolation for values. These helpers do not use interpolation.

import std::str
import std::vector

/// Joins `parts` with `sep` between elements.
string join(string sep, string vec parts) do
    return sJoin(parts, sep)
end

/// Repeats s n times; n <= 0 or empty s yields an empty string.
/// Asserts on allocation failure or output-size overflow.
string repeat(string s, int n) do
    int size = len(s)
    if n <= 0 or size is 0 do
        return ""
    end
    assert n <= 9223372036854775806 / size
    int total = size * n
    string result = allocateString(total)
    int i = 0
    while i < total do
        result[i] = s[i % size]
        i = i + 1
    end
    return result
end

/// Left-pads to a byte width with ASCII spaces; never truncates.
string padStart(string s, int width) do
    int size = len(s)
    if width <= size do
        return s
    end
    string result = allocateString(width)
    int padding = width - size
    int i = 0
    while i < padding do
        result[i] = ' '
        i = i + 1
    end
    while i < width do
        result[i] = s[i - padding]
        i = i + 1
    end
    return result
end

/// Centers in a byte width with ASCII spaces; never truncates.
/// The extra space on odd padding goes right.
string padCenter(string s, int width) do
    int size = len(s)
    if width <= size do
        return s
    end
    string result = allocateString(width)
    int left = (width - size) / 2
    int i = 0
    while i < left do
        result[i] = ' '
        i = i + 1
    end
    while i < left + size do
        result[i] = s[i - left]
        i = i + 1
    end
    while i < width do
        result[i] = ' '
        i = i + 1
    end
    return result
end

/// Right-pads to a byte width with ASCII spaces; never truncates.
string padEnd(string s, int width) do
    int size = len(s)
    if width <= size do
        return s
    end
    string result = allocateString(width)
    int i = 0
    while i < size do
        result[i] = s[i]
        i = i + 1
    end
    while i < width do
        result[i] = ' '
        i = i + 1
    end
    return result
end
