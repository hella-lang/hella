// std::vector — vector helpers for Hella (real stdlib: pure Hella).
// Import via: import std::vector
// (named `vector`, not `vec`: `vec` is a compiler keyword and cannot
// appear as an import path segment).

import std::str
//
// Thin facades over the compiler's vector methods (`len`, `is_empty`,
// `push`, `pop`, `contains`, `first`, `last`) plus loop-based extras
// the method surface lacks (`iSum`, `iIndexOf`, `sJoin`).
// No overloading in Hella, so one prefix per element type:
// `i*` = int vec, `s*` = string vec, `d*` = double vec.
// Mutating helpers (`*Push`, `*Pop`, `*Clear`) take `ref` so the
// caller's length/capacity header is updated.

/// Returns the length of int vec `v`.
int iLen(int vec v) do
    return v.len()
end

/// Returns true when int vec `v` is empty.
bool iIsEmpty(int vec v) do
    return v.is_empty()
end

/// Returns true when int vec `v` contains `x`.
bool iContains(int vec v, int x) do
    return v.contains(x)
end

/// Returns the first element of int vec `v`.
int iFirst(int vec v) do
    return v.first()
end

/// Returns the last element of int vec `v`.
int iLast(int vec v) do
    return v.last()
end

/// Pushes `x` onto int vec `v`.
void iPush(ref int vec v, int x) do
    v.push(x)
end

/// Pops and returns the last element of int vec `v`.
int iPop(ref int vec v) do
    return v.pop()
end

// NOTE: no `iClear`/`sClear` facades: the compiler's `clear()` method
// fails LLVM verification even on locals (dangling idx loop), so it is
// unusable through any wrapper until codegen is fixed. `pop` in a loop
// or rebinding to a fresh literal covers the need.

/// Returns the sum of int vec `v`.
int iSum(int vec v) do
    int total = 0
    int i = 0
    int n = v.len()
    while i < n do
        total = total + v[i]
        i = i + 1
    end
    return total
end

/// Returns the first index of `x` in int vec `v`, or `-1`.
int iIndexOf(int vec v, int x) do
    int i = 0
    int n = v.len()
    while i < n do
        if v[i] is x do
            return i
        end
        i = i + 1
    end
    return -1
end

/// Returns the length of string vec `v`.
int sLen(string vec v) do
    return v.len()
end

/// Returns true when string vec `v` is empty.
bool sIsEmpty(string vec v) do
    return v.is_empty()
end

// NOTE: not `v.contains(x)` — the compiler's `contains` on string
// (ptr-element) vecs hangs at runtime (broken ptr-compare lowering,
// even on locals). strcmp-based loop instead.
/// Returns true when string vec `v` contains `x` (strcmp-based).
bool sContains(string vec v, string x) do
    int i = 0
    int n = v.len()
    while i < n do
        if equals(v[i], x) do
            return true
        end
        i = i + 1
    end
    return false
end

/// Returns the first element of string vec `v`.
string sFirst(string vec v) do
    return v.first()
end

/// Returns the last element of string vec `v`.
string sLast(string vec v) do
    return v.last()
end

/// Pushes `x` onto string vec `v`.
void sPush(ref string vec v, string x) do
    v.push(x)
end

/// Pops and returns the last element of string vec `v`.
string sPop(ref string vec v) do
    return v.pop()
end

/// Joins string vec `v` with `sep` between elements.
string sJoin(string vec v, string sep) do
    int n = v.len()
    int total = 0
    int i = 0
    int sepSize = len(sep)
    while i < n do
        int size = len(v[i])
        assert size <= 9223372036854775806 - total
        total = total + size
        if i > 0 do
            assert sepSize <= 9223372036854775806 - total
            total = total + sepSize
        end
        i = i + 1
    end
    string result = allocateString(total)
    int dest = 0
    i = 0
    while i < n do
        int j = 0
        if i > 0 do
            while j < sepSize do
                result[dest] = sep[j]
                dest = dest + 1
                j = j + 1
            end
        end
        string part = v[i]
        int size = len(part)
        j = 0
        while j < size do
            result[dest] = part[j]
            dest = dest + 1
            j = j + 1
        end
        i = i + 1
    end
    return result
end

// NOTE: no `dContains` — the compiler's `contains` on double vecs
// miscompiles f64 comparison (false even on locals). No `dSum` either:
// `+` has no double overload in codegen yet.
/// Returns the length of double vec `v`.
int dLen(double vec v) do
    return v.len()
end

/// Pushes `x` onto double vec `v`.
void dPush(ref double vec v, double x) do
    v.push(x)
end
