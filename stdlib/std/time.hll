// std::time — wall-clock time for Hella (B2).
// Import via: import std::time
//
// `sleepMs`/`yieldNow` stay in `std::task` (cooperative checkpoints).
// This module is wall-clock observation over `runtime/hella_sync.c`
// (linked only when `std::sync`/`std::chan`/`std::time`/`std::net` is
// imported) plus libc calendar conversion. `bool+ref/out` errors: clocks
// never fail visibly (fallback 0/`""`); durations are plain `int` math.

import std::str
import std::num

extern "c" from "hella_sync" do
    int hella_wall_micros()
    int hella_monotonic_micros()
end

// Calendar layout shared by every platform backend below (C `struct tm`
// order with 32-bit fields; Hella `int` would be 64-bit and misalign).
// Includes the POSIX extensions (`tm_gmtoff`, `tm_zone`): glibc and macOS
// `gmtime_r` write all 56 bytes, so a 9-field alloca would let the call
// overflow its stack slot. Windows `struct tm` is 36 bytes — the extra
// fields simply stay zero there.
extern "c" from "libc" do
    struct Tm has
        i32 sec
        i32 min
        i32 hour
        i32 mday
        i32 mon
        i32 year
        i32 wday
        i32 yday
        i32 isdst
        int gmtoff
        string zone
    end
end

// POSIX conversion (returns the pointer, null on failure).
@cfg(unix)
extern "c" from "libc" do
    string gmtime_r(ref int t, ref Tm res)
    string localtime_r(ref int t, ref Tm res)
end

// Windows conversion: reversed arguments, errno return (0 is success).
@cfg(windows)
extern "c" from "libc" do
    int gmtime_s(ref Tm res, ref int t)
    int localtime_s(ref Tm res, ref int t)
end

extern "c" from "libc" do
    int clock()
end

/// Milliseconds since the Unix epoch (wall clock, NOT monotonic — for
/// timestamps, timeouts and deadlines, not short-interval benchmarks).
int wallMs() do
    return hella_wall_micros() / 1000
end

/// Microseconds since the Unix epoch (same clock as `wallMs`).
int wallMicros() do
    return hella_wall_micros()
end

/// Deadline `timeoutMs` after `fromMs` (both `wallMs` readings).
int deadlineMs(int fromMs, int timeoutMs) do
    return fromMs + timeoutMs
end

/// True when `wallMs()` has passed `deadline`.
bool expiredMs(int deadline) do
    return wallMs() >= deadline
end

/// Monotonic milliseconds for elapsed measurement: immune to NTP steps,
/// DST, and manual clock changes — use for benchmarks, rates, and
/// short-interval durations, never time-of-day (that is `wallMs`).
/// Backends: `CLOCK_MONOTONIC` (Linux), monotonic-raw hardware counter
/// (macOS, which rejects `CLOCK_MONOTONIC`), `QueryPerformanceCounter`
/// (Windows). Zero on backend failure; wraps rarely on very long runs.
int monotonicMs() do
    return hella_monotonic_micros() / 1000
end

/// Monotonic microseconds (same clock as `monotonicMs`).
int monotonicMicros() do
    return hella_monotonic_micros()
end

/// Two-digit rendering (`7` → `"07"`; wider values pass through).
string twoDigits(int v) do
    if v < 10 do
        return concat("0", toString(v))
    end
    return toString(v)
end

/// Renders calendar fields as `"YYYY-MM-DD HH:MM:SS"` (fixed 19 chars).
/// Month is 1-based here (callers add 1 to `tm.mon`); year is full.
string renderDate(int year, int mon, int mday, int hour, int min, int sec) do
    string s = toString(year)
    s = concat(s, "-")
    s = concat(s, twoDigits(mon))
    s = concat(s, "-")
    s = concat(s, twoDigits(mday))
    s = concat(s, " ")
    s = concat(s, twoDigits(hour))
    s = concat(s, ":")
    s = concat(s, twoDigits(min))
    s = concat(s, ":")
    s = concat(s, twoDigits(sec))
    return s
end

/// Current UTC date/time as `"YYYY-MM-DD HH:MM:SS"`, or `""` on failure.
/// No timezone suffix is emitted (it is always UTC by construction).
@cfg(unix)
string dateUtc() do
    int secs = wallMs() / 1000
    Tm tm
    string r = gmtime_r(ref secs, ref tm)
    if r is null do
        return ""
    end
    return renderDate(tm.year + 1900, tm.mon + 1, tm.mday, tm.hour, tm.min, tm.sec)
end

/// Current local date/time, same format and failure convention as
/// `dateUtc` (system timezone; DST handled by libc).
@cfg(unix)
string dateLocal() do
    int secs = wallMs() / 1000
    Tm tm
    string r = localtime_r(ref secs, ref tm)
    if r is null do
        return ""
    end
    return renderDate(tm.year + 1900, tm.mon + 1, tm.mday, tm.hour, tm.min, tm.sec)
end

/// Windows `dateUtc` (see above): `gmtime_s` takes `(tm, time)` and
/// reports errors as errno instead of a null pointer.
@cfg(windows)
string dateUtc() do
    int secs = wallMs() / 1000
    Tm tm
    int e = gmtime_s(ref tm, ref secs)
    if e is not 0 do
        return ""
    end
    return renderDate(tm.year + 1900, tm.mon + 1, tm.mday, tm.hour, tm.min, tm.sec)
end

/// Windows `dateLocal` (see above).
@cfg(windows)
string dateLocal() do
    int secs = wallMs() / 1000
    Tm tm
    int e = localtime_s(ref tm, ref secs)
    if e is not 0 do
        return ""
    end
    return renderDate(tm.year + 1900, tm.mon + 1, tm.mday, tm.hour, tm.min, tm.sec)
end

/// Processor milliseconds consumed by this process (ISO C `clock()`).
/// Monotonic while the process runs, but it is CPU time, NOT wall time:
/// sleeping, waiting on I/O, or parked tasks do not advance it. Use it
/// for benchmarking CPU-bound work and short-interval CPU durations —
/// never for wall timeouts or time-of-day (that is `wallMs`). Wraps
/// (rarely) on very long runs.
@cfg(unix)
int cpuMs() do
    // POSIX CLOCKS_PER_SEC is 1000000.
    return clock() / 1000
end

/// Windows half of `cpuMs` (see above): UCRT CLOCKS_PER_SEC is 1000,
/// so `clock()` already ticks in milliseconds — no division.
@cfg(windows)
int cpuMs() do
    return clock()
end
