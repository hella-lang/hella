// std::map — map helpers for Hella (real stdlib: pure Hella).
// Import via: import std::map
//
// Read-only facades (`len`, `is_empty` via methods; `*Has`, `*GetOr`
// via `for`-in iteration). No overloading in Hella, so one prefix per
// key/value pair: `si*` = string:int, `ii*` = int:int,
// `ss*` = string:string.
//
// NOTE: no mutating facades (`remove`/`clear`, keyed `contains`/
// `get_or` methods, `m[k]` subscript): key-taking map operations fail
// LLVM verification through by-value params, and `ref` params cannot
// carry map method calls (`cannot infer type`) until codegen is fixed.
// Mutate maps with direct calls on locals instead — subscript
// insert/update/read (`m[k] = v`, `m[k]`), `contains`/`get_or`/`len`/
// `is_empty` methods, `m.remove(k)` — except `m.clear()`, which
// miscompiles (LLVM verification): pop in a loop or rebind.
// See `examples/stdlib_collections.hll` for the working pattern.
// Missing-key reads yield the zero value; `*GetOr` supplies a fallback.

import std::str

/// Returns the number of entries in string:int map `m`.
int siLen(string:int m) do
    return m.len()
end

/// Returns true when string:int map `m` is empty.
bool siIsEmpty(string:int m) do
    return m.is_empty()
end

/// Returns true when string:int map `m` holds key `k`.
bool siHas(string:int m, string k) do
    for key in m do
        if equals(key, k) do
            return true
        end
    end
    return false
end

/// Returns `m[k]`, or `d` when `k` is missing.
int siGetOr(string:int m, string k, int d) do
    for key, val in m do
        if equals(key, k) do
            return val
        end
    end
    return d
end

/// Returns the number of entries in int:int map `m`.
int iiLen(int:int m) do
    return m.len()
end

/// Returns true when int:int map `m` is empty.
bool iiIsEmpty(int:int m) do
    return m.is_empty()
end

/// Returns true when int:int map `m` holds key `k`.
bool iiHas(int:int m, int k) do
    for key in m do
        if key is k do
            return true
        end
    end
    return false
end

/// Returns `m[k]`, or `d` when `k` is missing.
int iiGetOr(int:int m, int k, int d) do
    for key, val in m do
        if key is k do
            return val
        end
    end
    return d
end

/// Returns the number of entries in string:string map `m`.
int ssLen(string:string m) do
    return m.len()
end

/// Returns true when string:string map `m` is empty.
bool ssIsEmpty(string:string m) do
    return m.is_empty()
end

/// Returns true when string:string map `m` holds key `k`.
bool ssHas(string:string m, string k) do
    for key in m do
        if equals(key, k) do
            return true
        end
    end
    return false
end

/// Returns `m[k]`, or `d` when `k` is missing.
string ssGetOr(string:string m, string k, string d) do
    for key, val in m do
        if equals(key, k) do
            return val
        end
    end
    return d
end
