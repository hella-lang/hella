// std::str — string utilities for Hella (real stdlib: pure Hella + extern FFI).
// Import via: import std::str

extern "c" from "libc" do
    int strlen(string s)
    int strcmp(string a, string b)
    int strncmp(string a, string b, int n)
    string strdup(string s)
    string calloc(int n, int size)
end

/// Returns the byte length of `s` (via `strlen`).
int len(string s) do
    return strlen(s)
end

/// Returns true when `s` is empty.
bool isEmpty(string s) do
    return strlen(s) is 0
end

/// Returns true when `a` and `b` hold the same bytes.
bool equals(string a, string b) do
    return strcmp(a, b) is 0
end

/// Compares `a` against `b` (`< 0`, `0`, `> 0`, via `strcmp`).
int compare(string a, string b) do
    return strcmp(a, b)
end

/// Returns true when `hay` contains `needle`.
/// An empty `needle` always matches.
bool contains(string hay, string needle) do
    return indexOf(hay, needle) >= 0
end

/// Returns true when `s` starts with `prefix`.
/// An empty `prefix` always matches.
bool startsWith(string s, string prefix) do
    int plen = strlen(prefix)
    if plen is 0 do
        return true
    end
    if strlen(s) < plen do
        return false
    end
    return strncmp(s, prefix, plen) is 0
end

/// Returns true when `s` ends with `suffix`.
/// An empty `suffix` always matches.
bool endsWith(string s, string suffix) do
    int slen = strlen(s)
    int plen = strlen(suffix)
    int start = 0
    int k = 0
    if plen is 0 do
        return true
    end
    if slen < plen do
        return false
    end
    start = slen - plen
    k = 0
    while k < plen do
        if s[start + k] is not suffix[k] do
            return false
        end
        k = k + 1
    end
    return true
end

/// Returns a heap copy of `s` (via `strdup`).
string clone(string s) do
    return strdup(s)
end

/// Returns `s[start..stop]` (clamped to bounds).
/// Returns `""` when `stop < start`.
string substring(string s, int start, int stop) do
    int slen = strlen(s)
    string res = ""
    int n = 0
    int i = 0
    if start < 0 do
        start = 0
    end
    if stop > slen do
        stop = slen
    end
    if stop < start do
        return ""
    end
    n = stop - start
    res = allocateString(n)
    i = 0
    while i < n do
        res[i] = s[start + i]
        i = i + 1
    end
    return res
end


/// Allocates a zero-terminated writable string of size bytes, initially zero.
/// Low-level helper: asserts on invalid size or allocation failure.
/// Raw strings are not RAII-owned; see stdlib/README.md before freeing.
string allocateString(int size) do
    assert size >= 0
    assert size <= 9223372036854775806
    string result = calloc(1, size + 1)
    assert result is not null
    return result
end

/// Concatenates `a` and `b` into a freshly allocated string (exact-size,
/// no interpolation buffer). A3 builder primitive for unbounded text:
/// `concat(concat(a, b), c)` instead of `"{a}{b}{c}"` for large inputs.
/// Returns a new heap buffer; see README before freeing.
string concat(string a, string b) do
    int la = len(a)
    int lb = len(b)
    assert la <= 9223372036854775806 - lb
    string res = allocateString(la + lb)
    int i = 0
    while i < la do
        res[i] = a[i]
        i = i + 1
    end
    int j = 0
    while j < lb do
        res[la + j] = b[j]
        j = j + 1
    end
    return res
end

/// Finds needle at/after start; returns a byte offset or -1.
/// Negative start clamps to zero; start > len(hay) fails even for empty needle.
int indexOfFrom(string hay, string needle, int start) do
    int h = len(hay)
    int n = len(needle)
    if start < 0 do
        start = 0
    end
    if start > h or n > h do
        return -1
    end
    int i = start
    while i <= h - n do
        int j = 0
        while j < n do
            if hay[i + j] is not needle[j] do
                break
            end
            j = j + 1
        end
        if j is n do
            return i
        end
        i = i + 1
    end
    return -1
end

/// First byte offset of needle, or -1; an empty needle matches at zero.
int indexOf(string hay, string needle) do
    return indexOfFrom(hay, needle, 0)
end

/// Last byte offset of needle, or -1; empty needle matches at len(hay).
int lastIndexOf(string hay, string needle) do
    int n = len(needle)
    int i = len(hay) - n
    while i >= 0 do
        int j = 0
        while j < n do
            if hay[i + j] is not needle[j] do
                break
            end
            j = j + 1
        end
        if j is n do
            return i
        end
        i = i - 1
    end
    return -1
end

/// ASCII whitespace only: space, tab, LF, CR, vertical tab and form feed.
bool isAsciiSpace(char c) do
    return c is ' ' or c is '\t' or c is '\n' or c is '\r' or c is '\x0b' or c is '\f'
end

/// Removes ASCII whitespace from both ends (byte-oriented, not Unicode).
string trim(string s) do
    int start = 0
    int stop = len(s)
    while start < stop do
        if not isAsciiSpace(s[start]) do
            break
        end
        start = start + 1
    end
    while stop > start do
        if not isAsciiSpace(s[stop - 1]) do
            break
        end
        stop = stop - 1
    end
    return substring(s, start, stop)
end

/// Streaming split: initialize cursor = 0, call until cursor becomes -1.
/// Preserves empty fields, including the final field. Empty sep yields s once.
/// No vector capacity limit. Do not change s/sep between calls.
string splitNext(string s, string sep, ref int cursor) do
    int size = len(s)
    if cursor < 0 or cursor > size do
        cursor = -1
        return ""
    end
    int start = cursor
    int found = -1
    if len(sep) > 0 do
        found = indexOfFrom(s, sep, start)
    end
    if found < 0 do
        cursor = -1
        return substring(s, start, size)
    end
    cursor = found + len(sep)
    return substring(s, start, found)
end

/// Replaces left-to-right non-overlapping matches. Empty needle is a no-op.
/// Exact-size allocation, with checked output-size arithmetic; never recursive.
string replaceAll(string s, string needle, string replacement) do
    int size = len(s)
    int n = len(needle)
    int r = len(replacement)
    if n is 0 do
        return s
    end
    int count = 0
    int pos = indexOf(s, needle)
    while pos >= 0 do
        count = count + 1
        pos = indexOfFrom(s, needle, pos + n)
    end
    if count is 0 do
        return s
    end
    int total = size - count * n
    if r > 0 do
        assert count <= (9223372036854775806 - total) / r
    end
    total = total + count * r
    string result = allocateString(total)
    int source = 0
    int dest = 0
    pos = indexOf(s, needle)
    while pos >= 0 do
        while source < pos do
            result[dest] = s[source]
            dest = dest + 1
            source = source + 1
        end
        int j = 0
        while j < r do
            result[dest] = replacement[j]
            dest = dest + 1
            j = j + 1
        end
        source = pos + n
        pos = indexOfFrom(s, needle, source)
    end
    while source < size do
        result[dest] = s[source]
        dest = dest + 1
        source = source + 1
    end
    return result
end

/// Replaces the first non-overlapping match only. Empty needle is a
/// no-op. Exact-size allocation with checked arithmetic; returns `s`
/// unchanged (same pointer) when the needle is absent.
string replaceFirst(string s, string needle, string replacement) do
    int size = len(s)
    int n = len(needle)
    int r = len(replacement)
    if n is 0 do
        return s
    end
    int pos = indexOf(s, needle)
    if pos < 0 do
        return s
    end
    int total = size - n
    if r > 0 do
        assert total <= 9223372036854775806 - r
    end
    total = total + r
    string result = allocateString(total)
    int i = 0
    while i < pos do
        result[i] = s[i]
        i = i + 1
    end
    int j = 0
    while j < r do
        result[pos + j] = replacement[j]
        j = j + 1
    end
    int tail = pos + n
    while tail < size do
        result[tail - n + r] = s[tail]
        tail = tail + 1
    end
    return result
end

/// Upper-cases ASCII letters (`a`-`z`); other bytes pass through unchanged.
string toUpper(string s) do
    string lower = "abcdefghijklmnopqrstuvwxyz"
    string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    int n = len(s)
    string res = allocateString(n)
    int i = 0
    while i < n do
        char c = s[i]
        int j = 0
        while j < 26 do
            if lower[j] is c do
                break
            end
            j = j + 1
        end
        if j < 26 do
            res[i] = upper[j]
        end else do
            res[i] = c
        end
        i = i + 1
    end
    return res
end

/// Lower-cases ASCII letters (`A`-`Z`); other bytes pass through unchanged.
string toLower(string s) do
    string lower = "abcdefghijklmnopqrstuvwxyz"
    string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    int n = len(s)
    string res = allocateString(n)
    int i = 0
    while i < n do
        char c = s[i]
        int j = 0
        while j < 26 do
            if upper[j] is c do
                break
            end
            j = j + 1
        end
        if j < 26 do
            res[i] = lower[j]
        end else do
            res[i] = c
        end
        i = i + 1
    end
    return res
end

/// Returns true for ASCII digits (`0`-`9`).
bool isDigit(char c) do
    string digits = "0123456789"
    int i = 0
    while i < 10 do
        if digits[i] is c do
            return true
        end
        i = i + 1
    end
    return false
end

/// Returns true for ASCII letters (`a`-`z`, `A`-`Z`).
bool isAlpha(char c) do
    string letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    int i = 0
    while i < 52 do
        if letters[i] is c do
            return true
        end
        i = i + 1
    end
    return false
end

/// Returns true for ASCII letters and digits.
bool isAlphaNum(char c) do
    return isDigit(c) or isAlpha(c)
end

/// Removes leading ASCII whitespace (see `trim` for the definition).
string trimStart(string s) do
    int start = 0
    int stop = len(s)
    while start < stop do
        if not isAsciiSpace(s[start]) do
            break
        end
        start = start + 1
    end
    return substring(s, start, stop)
end

/// Removes trailing ASCII whitespace (see `trim` for the definition).
string trimEnd(string s) do
    int start = 0
    int stop = len(s)
    while stop > start do
        if not isAsciiSpace(s[stop - 1]) do
            break
        end
        stop = stop - 1
    end
    return substring(s, start, stop)
end

/// Counts non-overlapping occurrences of `needle` in `s` (byte-based).
/// An empty `needle` yields `len(s) + 1` (Go `strings.Count` parity).
int count(string s, string needle) do
    int n = len(needle)
    if n is 0 do
        return len(s) + 1
    end
    int total = 0
    int pos = indexOf(s, needle)
    while pos >= 0 do
        total = total + 1
        pos = indexOfFrom(s, needle, pos + n)
    end
    return total
end

/// ASCII case-insensitive equality: `A`-`Z` match `a`-`z`.
/// Other bytes compare exactly; non-ASCII text is NOT folded.
/// Allocates nothing (folds per byte instead of via `toLower`).
bool equalsIgnoreCase(string a, string b) do
    int n = len(a)
    if len(b) is not n do
        return false
    end
    string lower = "abcdefghijklmnopqrstuvwxyz"
    string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    int i = 0
    while i < n do
        char c1 = a[i]
        char c2 = b[i]
        if c1 is not c2 do
            int j = 0
            while j < 26 do
                if upper[j] is c1 do
                    c1 = lower[j]
                    break
                end
                j = j + 1
            end
            j = 0
            while j < 26 do
                if upper[j] is c2 do
                    c2 = lower[j]
                    break
                end
                j = j + 1
            end
            if c1 is not c2 do
                return false
            end
        end
        i = i + 1
    end
    return true
end

/// Returns `s` without the leading `prefix`, or `s` unchanged when absent.
/// No allocation on miss (returns the input pointer); a hit allocates.
string trimPrefix(string s, string prefix) do
    if startsWith(s, prefix) do
        return substring(s, len(prefix), len(s))
    end
    return s
end

/// Returns `s` without the trailing `suffix`, or `s` unchanged when absent.
/// No allocation on miss (returns the input pointer); a hit allocates.
string trimSuffix(string s, string suffix) do
    if endsWith(s, suffix) do
        return substring(s, 0, len(s) - len(suffix))
    end
    return s
end

/// Streaming whitespace split: initialize cursor = 0, call while it is
/// nonnegative. ASCII-whitespace runs collapse (no empty fields, unlike
/// `splitNext`); leading/trailing runs produce nothing, and the last field
/// arrives with cursor already -1 (no extra draining call). Byte-oriented.
/// No vector capacity limit. Do not change s between calls.
string splitNextSpace(string s, ref int cursor) do
    int size = len(s)
    if cursor < 0 or cursor > size do
        cursor = -1
        return ""
    end
    int start = cursor
    while start < size do
        if not isAsciiSpace(s[start]) do
            break
        end
        start = start + 1
    end
    if start >= size do
        cursor = -1
        return ""
    end
    int stop = start
    while stop < size do
        if isAsciiSpace(s[stop]) do
            break
        end
        stop = stop + 1
    end
    // Look past trailing whitespace so the final field is delivered with
    // cursor -1, matching `splitNext` (callers stop without an extra call).
    int ahead = stop
    while ahead < size do
        if not isAsciiSpace(s[ahead]) do
            break
        end
        ahead = ahead + 1
    end
    if ahead >= size do
        cursor = -1
    end else do
        cursor = stop
    end
    return substring(s, start, stop)
end
