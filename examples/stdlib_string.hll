// stdlib_string.hll — regression for std::str

import std::str
import std::io

int main() do
    assert len("hello") is 5
    assert isEmpty("") is true
    assert isEmpty("x") is false
    assert equals("abc", "abc") is true
    assert equals("abc", "abd") is false
    assert compare("a", "b") < 0
    assert contains("hello world", "world") is true
    assert contains("hello", "x") is false
    assert contains("abc", "") is true
    assert startsWith("hello", "hell") is true
    assert startsWith("hello", "world") is false
    assert endsWith("hello", "llo") is true
    assert endsWith("hello", "hell") is false
    assert endsWith("hello", "") is true
    string sub = substring("hello world", 6, 11)
    assert equals(sub, "world") is true
    string cl = clone("hi")
    assert equals(cl, "hi") is true
    assert indexOf("", "") is 0
    assert indexOf("abc", "abcd") is -1
    assert indexOf("ababa", "aba") is 0
    assert indexOfFrom("ababa", "aba", 1) is 2
    assert indexOfFrom("abc", "", 3) is 3
    assert indexOfFrom("abc", "", 4) is -1
    assert indexOfFrom("abc", "a", -9) is 0
    assert lastIndexOf("ababa", "aba") is 2
    assert lastIndexOf("abc", "") is 3
    assert lastIndexOf("", "x") is -1
    assert lastIndexOf("abc", "x") is -1
    assert equals(substring("abc", -9, 99), "abc")
    assert equals(substring("abc", 9, 99), "")
    assert equals(substring("abc", 0, -1), "")
    assert equals(substring("abc", 2, 1), "")
    assert equals(trim(" \t\n\r\x0b\f"), "")
    assert equals(trim(" \t hello world \n"), "hello world")
    assert equals(trim(""), "")
    assert equals(trim("é"), "é")
    assert equals(trim(" hello "), " hello ")
    assert indexOf("éx", "x") is 2
    assert equals(replaceAll("aaaaa", "aa", "b"), "bba")
    assert equals(replaceAll("abc", "", "x"), "abc")
    assert equals(replaceAll("abc", "b", ""), "ac")
    assert equals(replaceAll("aaa", "a", "aa"), "aaaaaa")
    assert equals(replaceAll("abc", "x", "y"), "abc")
    assert equals(replaceAll("", "a", "b"), "")
    int cursor = 0
    assert equals(splitNext(",a,,", ",", ref cursor), "")
    assert cursor is 1
    assert equals(splitNext(",a,,", ",", ref cursor), "a")
    assert equals(splitNext(",a,,", ",", ref cursor), "")
    assert cursor is 4
    assert equals(splitNext(",a,,", ",", ref cursor), "")
    assert cursor is -1
    assert equals(splitNext(",a,,", ",", ref cursor), "")
    cursor = 0
    assert equals(splitNext("abc", "", ref cursor), "abc")
    assert cursor is -1
    cursor = 0
    assert equals(splitNext("", ",", ref cursor), "")
    assert cursor is -1
    cursor = 0
    assert equals(splitNext("a::b", "::", ref cursor), "a")
    assert equals(splitNext("a::b", "::", ref cursor), "b")
    assert cursor is -1
    cursor = 99
    assert equals(splitNext("a", ",", ref cursor), "")
    assert cursor is -1
    assert equals(toUpper("abcXYZ09!"), "ABCXYZ09!")
    assert equals(toUpper(""), "")
    assert equals(toLower("abcXYZ09!"), "abcxyz09!")
    assert equals(toLower(""), "")
    assert isDigit('5') is true
    assert isDigit('a') is false
    assert isAlpha('z') is true
    assert isAlpha('Z') is true
    assert isAlpha('5') is false
    assert isAlphaNum('5') is true
    assert isAlphaNum('Q') is true
    assert isAlphaNum('!') is false
    assert equals(trimStart("  hi  "), "hi  ")
    assert equals(trimEnd("  hi  "), "  hi")
    assert equals(trimStart("hi"), "hi")
    assert equals(trimEnd("hi"), "hi")
    assert equals(trimStart(""), "")
    assert equals(trimEnd(""), "")
    assert count("hello", "l") is 2
    assert count("aaaaa", "aa") is 2
    assert count("ababa", "aba") is 1
    assert count("abc", "x") is 0
    assert count("", "a") is 0
    assert count("", "") is 1
    assert count("abc", "") is 4
    assert equalsIgnoreCase("Hello", "hELLO") is true
    assert equalsIgnoreCase("abc", "abd") is false
    assert equalsIgnoreCase("abc", "abcd") is false
    assert equalsIgnoreCase("", "") is true
    assert equalsIgnoreCase("é", "é") is true
    assert equalsIgnoreCase("é", "É") is false
    assert equals(trimPrefix("hello", "hell"), "o")
    assert equals(trimPrefix("hello", "world"), "hello")
    assert equals(trimPrefix("hello", ""), "hello")
    assert equals(trimPrefix("", "x"), "")
    assert equals(trimSuffix("hello", "llo"), "he")
    assert equals(trimSuffix("hello", "hell"), "hello")
    assert equals(trimSuffix("hello", ""), "hello")
    assert equals(trimSuffix("", "x"), "")
    cursor = 0
    assert equals(splitNextSpace("  a  b\tc\nd  ", ref cursor), "a")
    assert equals(splitNextSpace("  a  b\tc\nd  ", ref cursor), "b")
    assert equals(splitNextSpace("  a  b\tc\nd  ", ref cursor), "c")
    assert equals(splitNextSpace("  a  b\tc\nd  ", ref cursor), "d")
    assert cursor is -1
    assert equals(splitNextSpace("  a  b\tc\nd  ", ref cursor), "")
    cursor = 0
    assert equals(splitNextSpace("", ref cursor), "")
    assert cursor is -1
    cursor = 0
    assert equals(splitNextSpace("   \t\n ", ref cursor), "")
    assert cursor is -1
    cursor = 0
    assert equals(splitNextSpace("solo", ref cursor), "solo")
    assert cursor is -1
    cursor = 99
    assert equals(splitNextSpace("a b", ref cursor), "")
    assert cursor is -1

    println("string ok")
    return 0
end
