import std::num
import std::io
import std::str

void reject(string s) do
    int value = 123
    assert parseInt(s, ref value) is false
    assert value is 0
end

int main() do
    int value = 0
    assert parseInt("0", ref value)
    assert value is 0
    assert parseInt("-0", ref value)
    assert value is 0
    assert parseInt("+0042", ref value)
    assert value is 42
    assert parseInt("-123", ref value)
    assert value is -123
    assert parseInt("9223372036854775807", ref value)
    assert value is 9223372036854775807
    assert parseInt("-9223372036854775808", ref value)
    assert value is -9223372036854775807 - 1
    reject("")
    reject("+")
    reject("-")
    reject(" 1")
    reject("1 ")
    reject("1\n")
    reject("12x")
    reject("1_000")
    reject("0x10")
    reject("++1")
    reject("+-1")
    reject("é")
    reject("9223372036854775808")
    reject("-9223372036854775809")
    reject("999999999999999999999999999999")
    assert equals(toString(0), "0")
    assert equals(toString(42), "42")
    assert equals(toString(-42), "-42")
    assert equals(toString(9223372036854775807), "9223372036854775807")
    int imin = 0 - 9223372036854775807 - 1
    assert equals(toString(imin), "-9223372036854775808")
    // toString output round-trips through the strict parser
    assert parseInt(toString(-12345), ref value)
    assert value is -12345
    println("num ok")
    return 0
end
