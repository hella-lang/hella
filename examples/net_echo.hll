// net_echo — blocking TCP echo server + client (B2).
// The server accepts one connection, echoes one message, exits 0.
// Run: ./net_echo server & ./net_echo client; exit code is bytes echoed.

import std::io
import std::str
import std::net

int runServer(int port) do
    int listener = tcpListen(port)
    if listener is -1 do
        eprintln("listen failed")
        return 1
    end
    int conn = tcpAccept(listener)
    if conn is -1 do
        eprintln("accept failed")
        tcpClose(listener)
        return 1
    end
    string buf = allocateString(256)
    int n = tcpRecv(conn, buf, 255)
    if n <= 0 do
        eprintln("recv failed")
        tcpClose(conn)
        tcpClose(listener)
        return 1
    end
    int sent = tcpSend(conn, buf, n)
    tcpClose(conn)
    tcpClose(listener)
    if sent is n do
        return 0
    end
    return 1
end

int runClient(string ip, int port) do
    int fd = tcpConnect(ip, port)
    if fd is -1 do
        eprintln("connect failed")
        return 1
    end
    string msg = "hello hella"
    int n = len(msg)
    int sent = tcpSend(fd, msg, n)
    if sent is not n do
        eprintln("send failed")
        tcpClose(fd)
        return 1
    end
    string buf = allocateString(256)
    int got = tcpRecv(fd, buf, 255)
    tcpClose(fd)
    if got is n do
        println(buf)
        return 0
    end
    eprintln("echo mismatch")
    return 1
end

int main(string[] args) do
    int port = 18787
    if args.len() > 0 do
        if equals(args[0], "server") do
            return runServer(port)
        end
    end
    return runClient("127.0.0.1", port)
end
