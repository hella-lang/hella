// stdlib_fs.hll — regression for std::fs
//
// NOTE: scratch files live in the process working directory (relative
// paths), not /tmp — there is no /tmp on Windows. Run from the repo root
// so `hella_fs_test_tmp.txt` lands next to the checkout, and the test
// removes it on success.

import std::fs
import std::io
import std::str
import std::bytes
import std::fmt::{repeat}

int main() do
    string path = "hella_fs_test_tmp.txt"
    string data = "hello fs"
    string content = ""
    string content2 = ""
    string missing = ""
    assert tryWriteFile(path, data)
    assert tryReadFile(path, ref content)
    assert equals(content, data)
    int measured = -1
    assert tryFileSize(path, ref measured)
    assert measured is 8
    string checkedCopyPath = "hella_fs_checked_copy_tmp.txt"
    assert tryCopyFile(path, checkedCopyPath)
    assert tryReadFile(checkedCopyPath, ref content2)
    assert equals(content2, data)
    assert tryRemoveFile(checkedCopyPath)
    assert tryCopyFile("hella_no_such_file_xyz.txt", checkedCopyPath) is false
    assert exists(checkedCopyPath) is false
    assert tryAppendFile(path, "!")
    assert tryReadFile(path, ref content2)
    assert equals(content2, "hello fs!")
    assert tryRemoveFile(path)
    content = "sentinel"
    assert tryReadFile("hella_no_such_file_xyz.txt", ref content) is false
    assert isEmpty(content)
    measured = 99
    assert tryFileSize("hella_no_such_file_xyz.txt", ref measured) is false
    assert measured is -1
    assert tryReadFile(path, ref content) is false
    assert tryWriteFile(path, "")
    assert tryReadFile(path, ref content)
    assert isEmpty(content)
    assert tryFileSize(path, ref measured)
    assert measured is 0
    assert tryRemoveFile(path)
    string binaryPath = "hella_fs_binary_tmp.bin"
    u8 vec binary = vec[]
    u8 vec binaryRead = vec[]
    u8 vec emptyBytes = vec[]
    push(ref binary, 0)
    push(ref binary, 65)
    push(ref binary, 255)
    assert tryWriteFileBytes(binaryPath, binary)
    assert fileSize(binaryPath) is 3
    assert tryReadFileBytes(binaryPath, ref binaryRead)
    assert buffersEqual(binary, binaryRead)
    assert tryAppendFileBytes(binaryPath, binary)
    assert fileSize(binaryPath) is 6
    assert tryReadFileBytes(binaryPath, ref binaryRead)
    assert length(binaryRead) is 6
    assert tryRemoveFile(binaryPath)
    assert tryReadFileBytes("hella_missing_binary_tmp.bin", ref binaryRead) is false
    assert isEmptyBytes(binaryRead)
    string oversizedPath = "hella_fs_oversized_tmp.bin"
    assert tryWriteFile(oversizedPath, repeat("x", 257))
    binaryRead = fromString("old")
    assert tryReadFileBytes(oversizedPath, ref binaryRead) is false
    assert isEmptyBytes(binaryRead)
    assert tryRemoveFile(oversizedPath)
    assert tryWriteFileBytes(binaryPath, emptyBytes)
    assert tryReadFileBytes(binaryPath, ref binaryRead)
    assert isEmptyBytes(binaryRead)
    assert tryRemoveFile(binaryPath)
    writeFile(path, data)
    assert exists(path) is true
    assert fileSize(path) is 8
    content = readFile(path)
    assert equals(content, data) is true
    appendFile(path, "!")
    assert fileSize(path) is 9
    content2 = readFile(path)
    assert equals(content2, "hello fs!") is true
    removeFile(path)
    assert exists(path) is false
    missing = readFile("hella_no_such_file_xyz.txt")
    assert isEmpty(missing) is true
    assert fileSize("hella_no_such_file_xyz.txt") is -1
    string rpath = "hella_fs_test_tmp2.txt"
    assert copyFile("hella_no_such_file_xyz.txt", rpath) is false
    assert exists(rpath) is false
    writeFile(path, data)
    assert copyFile(path, rpath) is true
    assert fileSize(rpath) is 8
    assert equals(readFile(rpath), data) is true
    assert renameFile(rpath, path) is true
    assert exists(rpath) is false
    assert exists(path) is true
    assert equals(readFile(path), data) is true
    assert renameFile("hella_no_such_file_xyz.txt", rpath) is false
    writeFile(path, "")
    assert copyFile(path, rpath) is true
    assert fileSize(rpath) is 0
    removeFile(path)
    removeFile(rpath)
    assert exists(path) is false
    assert exists(rpath) is false
    println("fs ok")
    return 0
end
