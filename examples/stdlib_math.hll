// stdlib_math.hll — regression for std::math (REAL_STDLIB.md).
// Every name resolves to stdlib/std/math.hll via `import std::math`.

import std::math
import std::io

int main() do
    // integer helpers
    assert abs(-42) is 42
    assert abs(0) is 0
    assert min(3, 5) is 3
    assert max(3, 5) is 5
    assert clamp(10, 0, 5) is 5
    assert clamp(-1, 0, 5) is 0
    assert clamp(3, 0, 5) is 3

    // double libm — exactly-representable results asserted via
    // float `is` (ordered equality; NaN is never equal, even to itself)
    assert sqrt(4.0) is 2.0
    assert sqrt(9.0) is 3.0
    assert fabs(2.5) is 2.5
    assert absf(2.5) is 2.5
    assert floor(2.9) is 2.0
    assert ceil(2.1) is 3.0
    assert round(2.5) is 3.0
    assert pow(2.0, 3.0) is 8.0
    assert exp(0.0) is 1.0
    assert log(1.0) is 0.0
    assert sin(0.0) is 0.0
    assert sin(0.0) is not 1.0
    assert cos(0.0) is 1.0
    assert tan(0.0) is 0.0
    assert fmin(1.5, 2.5) is 1.5
    assert fmax(1.5, 2.5) is 2.5
    assert atan2(0.0, 1.0) is 0.0
    // clampf via fmin/fmax (negative double literals and `-` do not
    // exist for doubles, so the below-lo case comes from libm:
    // log(0.5) is negative)
    assert clampf(10.0, 0.0, 5.0) is 5.0
    double below = log(0.5)
    assert below is not 0.0
    assert clampf(below, 0.0, 5.0) is 0.0
    assert clampf(3.0, 0.0, 5.0) is 3.0
    println("doubles ok")

    println("math ok")
    return 0
end
