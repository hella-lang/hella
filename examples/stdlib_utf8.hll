import std::io
import std::str
import std::utf8


int main() do
    string text = "A¢€😀"
    assert len(text) is 10
    assert runeCount(text) is 4
    assert validate(text)
    int rune = 0
    assert decodeRuneAt(text, 0, ref rune) is 1
    assert rune is 65
    assert decodeRuneAt(text, 1, ref rune) is 2
    assert rune is 162
    assert decodeRuneAt(text, 3, ref rune) is 3
    assert rune is 8364
    assert decodeRuneAt(text, 6, ref rune) is 4
    assert rune is 128512
    assert byteOffset(text, 0) is 0
    assert byteOffset(text, 1) is 1
    assert byteOffset(text, 2) is 3
    assert byteOffset(text, 3) is 6
    assert byteOffset(text, 4) is 10
    assert byteOffset(text, 5) is -1
    assert runeAt(text, 0, ref rune)
    assert rune is 65
    assert runeAt(text, 3, ref rune)
    assert rune is 128512
    assert runeAt(text, 4, ref rune) is false
    string runeSlice = ""
    assert substringRunes(text, 1, 3, ref runeSlice)
    assert equals(runeSlice, "¢€")
    assert substringRunes(text, 2, 2, ref runeSlice)
    assert isEmpty(runeSlice)
    assert substringRunes(text, 4, 4, ref runeSlice)
    assert isEmpty(runeSlice)
    runeSlice = "sentinel"
    assert substringRunes(text, 3, 2, ref runeSlice) is false
    assert isEmpty(runeSlice)
    assert substringRunes(text, 0, 5, ref runeSlice) is false
    assert isEmpty(runeSlice)
    string encoded = ""
    assert encodeRune(8364, ref encoded)
    assert equals(encoded, "€")
    assert encodeRune(128512, ref encoded)
    assert equals(encoded, "😀")
    assert encodeRune(0, ref encoded) is false
    assert isEmpty(encoded)
    assert encodeRune(55296, ref encoded) is false
    assert encodeRune(1114112, ref encoded) is false
    assert encodeRune(1114111, ref encoded)
    assert len(encoded) is 4
    assert decodeRuneAt(encoded, 0, ref rune) is 4
    assert rune is 1114111
    string malformed = allocateString(2)
    malformed[0] = 192
    malformed[1] = 175
    assert validate(malformed) is false
    assert runeCount(malformed) is 2
    assert decodeRuneAt(malformed, 0, ref rune) is 1
    assert rune is 65533
    assert byteOffset(malformed, 2) is 2
    assert runeAt(malformed, 0, ref rune)
    assert rune is 65533
    assert substringRunes(malformed, 0, 2, ref runeSlice)
    assert len(runeSlice) is 2
    assert equals(runeSlice, malformed)
    string truncated = allocateString(3)
    truncated[0] = 240
    truncated[1] = 159
    truncated[2] = 152
    assert validate(truncated) is false
    assert runeCount(truncated) is 3
    string surrogate = allocateString(3)
    surrogate[0] = 237
    surrogate[1] = 160
    surrogate[2] = 128
    assert validate(surrogate) is false
    string continuation = allocateString(1)
    continuation[0] = 128
    assert validate(continuation) is false
    assert decodeRuneAt(text, 10, ref rune) is 0
    assert decodeRuneAt(text, -1, ref rune) is 0
    println("utf8 ok")
    return 0
end
