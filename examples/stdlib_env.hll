// stdlib_env.hll — regression for std::env
//
// NOTE: asserts only cover variables this test sets itself plus cwd().
// Fixed names like HOME do not exist on every OS (Windows has neither
// HOME nor a case-sensitive environment), so they are not asserted on.

import std::env
import std::io
import std::str

int main() do
    string missing = ""
    string dir = ""
    missing = getEnv("THIS_VAR_DOES_NOT_EXIST_hella_test")
    assert isEmpty(missing) is true
    assert hasEnv("THIS_VAR_DOES_NOT_EXIST_hella_test") is false
    // set and check
    setEnv("HELLA_TEST_ENV", "hello_env")
    assert hasEnv("HELLA_TEST_ENV") is true
    assert equals(getEnv("HELLA_TEST_ENV"), "hello_env") is true
    unsetEnv("HELLA_TEST_ENV")
    assert isEmpty(getEnv("HELLA_TEST_ENV")) is true
    assert hasEnv("HELLA_TEST_ENV") is false
    dir = cwd()
    assert isEmpty(dir) is false
    // argv[0] is always present, even with no user args
    assert isEmpty(progName()) is false
    // home/temp dirs read fixed names, so the test controls them via
    // setEnv — no dependence on ambient HOME/TMPDIR on any OS.
    setEnv("HOME", "/home/testuser")
    setEnv("USERPROFILE", "C:/Users/testuser")
    assert equals(homeDir(), "/home/testuser") is true
    unsetEnv("HOME")
    assert equals(homeDir(), "C:/Users/testuser") is true
    unsetEnv("USERPROFILE")
    assert isEmpty(homeDir()) is true
    setEnv("TMPDIR", "/scratch")
    setEnv("TEMP", "/tmpwin")
    setEnv("TMP", "/tmpother")
    assert equals(tempDir(), "/scratch") is true
    unsetEnv("TMPDIR")
    assert equals(tempDir(), "/tmpwin") is true
    unsetEnv("TEMP")
    assert equals(tempDir(), "/tmpother") is true
    unsetEnv("TMP")
    assert isEmpty(tempDir()) is true
    println("env ok")
    return 0
end
