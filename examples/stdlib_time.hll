// stdlib_time.hll — regression for std::time
//
// Clocks are ambient (wall time; CPU usage), so asserts only check
// ordering/sanity, never exact values.

import std::time
import std::io
import std::str

int main() do
    int w1 = wallMs()
    int u1 = wallMicros()
    assert w1 > 0
    assert u1 > 0
    int w2 = wallMs()
    assert w2 >= w1
    int c1 = cpuMs()
    assert c1 >= 0
    int c2 = cpuMs()
    assert c2 >= c1
    int d = deadlineMs(w2, 10000)
    assert d is w2 + 10000
    assert expiredMs(w2) is true
    assert expiredMs(d) is false
    int m1 = monotonicMs()
    int u3 = monotonicMicros()
    assert m1 > 0
    assert u3 > 0
    assert u3 >= m1 * 1000 - 1000
    int m2 = monotonicMs()
    assert m2 >= m1
    int u4 = monotonicMicros()
    assert u4 >= u3
    // Calendar rendering is ambient (actual date), so only shape and
    // internal consistency are asserted: 19 fixed chars with separators
    // in the right slots, and lexicographic order matching time order.
    string du = dateUtc()
    assert len(du) is 19
    assert du[4] is '-'
    assert du[7] is '-'
    assert du[10] is ' '
    assert du[13] is ':'
    assert du[16] is ':'
    string dl = dateLocal()
    assert len(dl) is 19
    assert dl[4] is '-'
    assert dl[16] is ':'
    // NOTE: no exact-value or ordering asserts on calendar text — two
    // reads can straddle a second boundary. Shape is deterministic.
    println("time ok")
    return 0
end
