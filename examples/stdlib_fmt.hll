// stdlib_fmt.hll — regression for std::fmt (interpolation parity)

import std::fmt
import std::io
import std::str

int main() do
    string who = "bob"
    int n = 42
    string vec parts = ["a", "b"]
    string greeting = "hi {who}!"
    assert equals(greeting, "hi bob!") is true
    assert equals("n={n}", "n=42") is true
    assert equals(join(",", parts), "a,b") is true
    assert equals(repeat("ab", 3), "ababab") is true
    assert equals(repeat("ab", 0), "") is true
    assert equals(padStart("hi", 4), "  hi") is true
    assert equals(padEnd("hi", 4), "hi  ") is true
    assert equals(padStart("hello", 3), "hello") is true
    assert equals(padCenter("hi", 5), " hi  ") is true
    assert equals(padCenter("hi", 4), " hi ") is true
    assert equals(padCenter("hello", 3), "hello") is true
    assert equals(padCenter("", 3), "   ") is true
    // Beyond both the former 4KiB formatter slabs and 512-byte interpolation.
    string large = repeat("ab", 5000)
    assert len(large) is 10000
    assert startsWith(large, "abab")
    assert endsWith(large, "abab")
    assert len(padStart("x", 9000)) is 9000
    assert endsWith(padStart("x", 9000), "x")
    assert startsWith(padEnd("x", 9000), "x")
    assert len(padEnd("x", 9000)) is 9000
    string vec bigParts = [large, "", large]
    string joined = join("%s", bigParts)
    assert len(joined) is 20004
    assert equals(substring(joined, 10000, 10004), "%s%s")
    assert len(replaceAll(large, "a", "xyz")) is 20000
    assert equals(repeat("x", -1), "")
    assert equals(repeat("", 9223372036854775807), "")
    assert equals(padEnd("x", -1), "x")
    string vec empty = []
    assert equals(join(",", empty), "")
    string vec blanks = ["", "", ""]
    assert equals(join(",", blanks), ",,")
    int cursor = 0
    int count = 0
    string many = repeat("x,", 100)
    while cursor >= 0 do
        string field = splitNext(many, ",", ref cursor)
        count = count + 1
    end
    assert count is 101
    println("fmt ok")
    return 0
end
