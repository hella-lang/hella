// stdlib_log.hll — regression for std::log
//
// Log lines go to stderr with wall-clock millis prefixes (nondeterministic),
// so the e2e test matches level tags + messages, not whole lines.

import std::log
import std::io
import std::str

int main() do
    setLogLevel(LOG_DEBUG)
    logDebug("debug visible")
    logInfo("info visible")
    logWarn("warn visible")
    logError("error visible")
    emitLog("CUSTOM", "custom visible")
    setLogLevel(LOG_ERROR)
    logDebug("debug hidden")
    logInfo("info hidden")
    logWarn("warn hidden")
    logError("error still visible")
    println("log ok")
    return 0
end
